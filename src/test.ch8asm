main:
    dcl
    jif k[v0]
    jif !k[v0]
    set v0 = rnd 0x0F
    set v0 = 0x08
    set v2 = 0x0a
    jmp [:main + v0]
    set v0 = 0x10
    set v0 += 0x20
    set i = 0x103
    set i += v0
    jif v0 == 0xFF
    dcl
    jif v0 != 0xFF
    dcl
    set v1 = 0x01
    set v1 += v0
    set v1 = v0
    jif v0 == v1
    dcl
    set v1 = 0x02
    set v1 |= v0
    set v1 &= v0
    set v1 ^= v0
    set v1 -= v0
    set v1 = v0 - v1
    set v1 -= v0
    set v0 = v1 >> 0x1
    set v0 >>= 0x1
    set v0 = v1 << 0x1
    set v0 <<= 0x1
    set v1 -= v0
    jif v0 != v1
    dcl
    sbr :subroutine
infinite:
    jmp :infinite

subroutine:
    ret
